# market-agri-workflow — every variable this repository reads.
# Copy to .env (ignored by git) for a local run. Placeholders only: never commit real values.

# Read by application.yml: HTTP port inside the container
PORT=8080

# Read by application.yml: PostgreSQL of market-agri-infra, as workflow_app (never the administrator)
DATABASE_URL=jdbc:postgresql://postgres:5432/market_agri
DATABASE_USER=workflow_app
DATABASE_PASSWORD=<password>

# Read by the integration tests (./mvnw verify -Pintegration); scripts/test-database.sh prints it.
# When it is not set, the integration tests are skipped (Anexo C).
# TEST_DATABASE_URL=jdbc:postgresql://localhost:55435/market_agri?user=workflow_app&password=<password>

# Read by application.yml: tokens of auth, validated locally (ADR-020). Only the public key.
# JWT_PUBLIC_KEY is the PEM on one line with literal \n (market-agri-infra/scripts/dev-keys.sh
# writes it); JWT_PUBLIC_KEY_FILE, a file with the PEM, is used when JWT_PUBLIC_KEY is empty.
JWT_ISSUER=market-agri-auth
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public-key.pem

# Read by application.yml: the participants of the checkout saga (ADR-015) and the workflow's own
# service token (ADR-020: issued by auth with I-01, never committed; dev-keys.sh writes one in dev)
CHAT_API_URL=http://chat-api:8080
CATALOG_API_URL=http://catalog-api:8080
TRANSACTIONS_API_URL=http://transactions-api:8080
SERVICE_TOKEN=<token>
# Optional limits of each call (Anexo D): 3s and 3 when not set
# HTTP_TIMEOUT=3s
# HTTP_ATTEMPTS=3

# Read by deploy/compose.yml (from the market-agri-infra env file)
ENV=<dev|qa|main>
PG_DATABASE=market_agri
WORKFLOW_APP_PASSWORD=<password>
# PG_ADMIN_USER and PG_ADMIN_PASSWORD: only for workflow-db-migrate (deploy/compose.yml)
