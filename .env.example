# market-agri-workflow — every variable this repository reads.
# Copy to .env (ignored by git) for a local run. Placeholders only: never commit real values.

# Read by application.yml: HTTP port inside the container
PORT=8080

# Read by application.yml: PostgreSQL of market-agri-infra, as workflow_app (never the administrator)
DATABASE_URL=jdbc:postgresql://postgres:5432/market_agri
DATABASE_USER=workflow_app
DATABASE_PASSWORD=<password>

# Read by the integration tests (./mvnw verify -Pintegration); scripts/test-database.sh prints it.
# When it is not set, the integration tests are skipped (Anexo C).
# TEST_DATABASE_URL=jdbc:postgresql://localhost:55435/market_agri?user=workflow_app&password=<password>

# Read by deploy/compose.yml (from the market-agri-infra env file)
ENV=<dev|qa|main>
PG_DATABASE=market_agri
WORKFLOW_APP_PASSWORD=<password>
# PG_ADMIN_USER and PG_ADMIN_PASSWORD: only for workflow-db-migrate (deploy/compose.yml)
